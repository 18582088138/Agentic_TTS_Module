# Agentic TTS Module —— 环境变量模板 / environment template
#
# 复制为 .env 后填值；.env 已在 .gitignore，不入库。
# Copy to .env and fill in. .env is gitignored.
#
# 优先级 / priority: 进程环境变量 > .env。CI / 部署时直接 export 即可覆盖。
# Process env vars win over .env; CI / deployment can just export.

# ---- API 后端 / API backend -----------------------------------------------
# 启用云端 TTS 时必填。minimax 支持国内（api.minimaxi.com）与海外（api.minimax.io）
# 两套 endpoint，引擎会根据 key 鉴权结果自动选能用的那一个。
# Required when api.enabled=true in configs/config.yaml.
TTS_API_KEY=

# 可选：覆盖默认 endpoint（空 = 按 key 自动选）
# Override the default endpoint (empty = auto-pick by key prefix).
TTS_API_ENDPOINT=

# 可选：覆盖默认模型（空 = 走 configs/config.yaml 的 api.model）
# Override the default model (empty = use api.model from configs/config.yaml).
TTS_API_MODEL=

# ---- 引擎与运行时（一般不用改，留给部署时临时覆盖）---------------------
# Engine & runtime overrides — usually left alone; for deployments only.
# TTS_BACKEND=qwen3
# TTS_DEVICE=auto
# TTS_DTYPE=auto
# TTS_SEED=20260907
# TTS_MAX_RESIDENT=1
# TTS_MODELS_DIR=
# TTS_REPO_DIR=
# TTS_VOICES_DIR=
# TTS_OUTPUT_DIR=
# TTS_SERVER_HOST=127.0.0.1
# TTS_SERVER_PORT=8300
